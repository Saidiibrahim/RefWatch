/* Copy to Secrets.xcconfig (DO NOT COMMIT) */
// OpenAI credentials are server-side only for the assistant proxy.
// Do not add a local OpenAI key here.

// Public iOS configuration only. Server/database/OpenAI secrets never belong here.
// Compose URLs without typing '//' to avoid .xcconfig comment parsing.
SCHEME = https
HOST = refwatch-api.your-account.workers.dev
SLASH = /
BACKEND_API_BASE_URL = $(SCHEME):$(SLASH)$(SLASH)$(HOST)

// Clerk publishable keys are safe to embed in the native client.
CLERK_PUBLISHABLE_KEY = pk_test_your-clerk-publishable-key

// Clerk Native Applications dashboard Frontend API host, without a scheme.
// Add webcredentials:$(CLERK_FRONTEND_API_HOST) to the iOS associated domains capability.
CLERK_FRONTEND_API_HOST = your-instance.clerk.accounts.dev

// Forbidden here: CLERK_SECRET_KEY, CLERK_JWT_KEY,
// CLERK_WEBHOOK_SIGNING_SECRET, DATABASE_URL/PlanetScale credentials,
// OPENAI_API_KEY, and any Cloudflare administrative token.
