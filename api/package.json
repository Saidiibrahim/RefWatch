{
  "name": "@refwatch/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "bash scripts/run-local-database-integration.sh",
    "test:db:historical:planetscale-rehearsal": "bash scripts/run-database-integration.sh",
    "test:local:routes": "bash scripts/run-local-route-matrix.sh",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:production:0016": "node scripts/apply-production-migration-0016.mjs",
    "db:migrate:production:0016:check": "node scripts/apply-production-migration-0016.mjs --check",
    "dry-run": "wrangler deploy --dry-run",
    "cutover:validate": "node scripts/validate-cutover-bundle.mjs",
    "launch:validate": "node scripts/validate-greenfield-launch-packet.mjs",
    "rollback:validate": "node scripts/validate-rollback-packet.mjs",
    "mutation:coverage": "node scripts/validate-mutation-coverage.mjs",
    "mutation:poison-rehearsal": "node scripts/create-ledger-poison-probe.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^3.11.4",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.30",
    "pg": "^8.16.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.4",
    "@cloudflare/workers-types": "^5.20260713.1",
    "@types/node": "^24.3.1",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  }
}
